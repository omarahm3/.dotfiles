#!/usr/bin/env bash
# Toggle between the current and previously focused space (tmux last-window, at
# session level). History comes from herdr-focus-tracker; herdr has no
# last_workspace action of its own.

source "$(dirname "$(readlink -f "$0")")/herdr-lib.sh"

previous=$(herdr_previous_workspace_id)
[[ -n $previous ]] || exit 0

# The space may have been closed since it was recorded.
herdr workspace list |
	jq -e --arg id "$previous" 'any(.result.workspaces[]; .workspace_id == $id)' \
		>/dev/null || exit 0

herdr workspace focus "$previous" >/dev/null
