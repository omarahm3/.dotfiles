  background:var(--paper2);color:var(--muted);border:1px solid var(--rule);
  border-radius:5px;padding:.35rem .6rem;cursor:pointer;line-height:1}
.bar button[aria-pressed="true"]{color:var(--accent);border-color:var(--accent);
  background:var(--tint)}
.bar .sep{width:.5rem}

.eyebrow{font-family:var(--mono);font-size:.64rem;letter-spacing:.16em;
  text-transform:uppercase;color:var(--muted);margin-bottom:.55rem}
h1{font-family:var(--serif);font-size:clamp(1.6rem,3vw + 1rem,2.2rem);
  font-weight:400;line-height:1.15;margin-bottom:.35rem;word-break:break-word}
.sub{color:var(--muted);font-size:.9rem;margin-bottom:1.75rem}

.action{background:var(--tint);border:1px solid var(--accent);border-radius:8px;
  padding:1.05rem 1.2rem;margin-bottom:1.6rem}
