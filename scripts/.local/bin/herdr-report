  font-family:var(--mono);font-size:.68rem;color:var(--soft);
  display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem}
@media print{.bar{display:none}}
"""

JS = r"""
(function(){
  var r=document.documentElement;
  function apply(lang,theme){
    r.setAttribute('data-lang',lang);
    r.setAttribute('data-theme',theme);
    r.setAttribute('lang',lang);
    r.setAttribute('dir',lang==='ar'?'rtl':'ltr');
    document.querySelectorAll('[data-set-lang]').forEach(function(b){
      b.setAttribute('aria-pressed',String(b.dataset.setLang===lang));});
    document.querySelectorAll('[data-set-theme]').forEach(function(b){
      b.setAttribute('aria-pressed',String(b.dataset.setTheme===theme));});
    try{localStorage.setItem('hr.lang',lang);localStorage.setItem('hr.theme',theme);}catch(e){}
  }
  var lang,theme;
  try{lang=localStorage.getItem('hr.lang');theme=localStorage.getItem('hr.theme');}catch(e){}
  if(!lang)lang='en';
  if(!theme)theme=(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';
  apply(lang,theme);
  document.addEventListener('click',function(e){
    var b=e.target.closest('[data-set-lang],[data-set-theme]');
    if(!b)return;
    apply(b.dataset.setLang||r.getAttribute('data-lang'),
          b.dataset.setTheme||r.getAttribute('data-theme'));
  });
})();
"""


def read(p: Path) -> str:
    try:
        return p.read_text(errors="replace")
    except Exception:
        return ""


def verdict_of(text: str) -> str:
    """Last verdict wins — agents restate their summary at the end."""
    hits = re.findall(r"DO NOT SHIP|SHIP WITH FIXES|SHIP", text)
    return hits[-1] if hits else "NO REVIEW"


def diff_stats(diff: str) -> tuple[int, list[str]]:
    files = re.findall(r"^\+\+\+ b/(.+)$", diff, re.M)
    changed = len([l for l in diff.splitlines()
                   if (l.startswith("+") or l.startswith("-"))
                   and not l.startswith(("+++", "---"))])
    return changed, sorted(set(files))


def tail_summary(text: str, n: int = 6) -> list[str]:
    lines = [l.rstrip() for l in text.splitlines() if l.strip()]
    drop = re.compile(r"^(hook:|tokens used|\d+$|[-=─━]{3,})")
    lines = [l for l in lines if not drop.match(l.strip())]
    return lines[-n:] if lines else []


def esc(s: str) -> str:
    return html.escape(str(s), quote=False)


def md_code(s: str) -> str:
    """`x` and **x** from agent prose -> real markup, everything else escaped."""
    s = esc(s)
    s = re.sub(r"`([^`]+)`", r"<code>\1</code>", s)
    s = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", s)
    return s


def translate_ar(bundle: dict[str, list[str]]) -> dict[str, list[str]]:
    """Translate extracted English bullets to Arabic via one cheap agent pass.

    Chrome is translated by the table above, but the substance comes from agent
    transcripts and is always English. A page whose body is English is not an
    Arabic page. Falls back to the English text on any failure — English bullets
    beat no report.
    """
    payload = json.dumps(bundle, ensure_ascii=False)
    prompt = (
        "Translate the string values in this JSON from English to Modern Standard "
        "Arabic. Keep every key and the array structure identical. Do NOT translate "
        "code, file paths, commands, flags, package names, or anything inside "
        "backticks — keep those byte-for-byte. Reply with ONLY the JSON, no "
        "markdown fence, no commentary.\n\n" + payload
    )
    lib = Path.home() / ".local/bin/herdr-agents-lib.sh"
    if not lib.exists():
        return bundle
    try:
        r = subprocess.run(
            ["bash", "-c", f'source {lib!s} && agent_run opencode "$1"', "_", prompt],
            capture_output=True, text=True, timeout=300,
        )
        m = re.search(r"\{.*\}", r.stdout, re.S)
        if not m:
            return bundle
        got = json.loads(m.group())
        if set(got) != set(bundle):
            return bundle
        return {k: [str(x) for x in v] for k, v in got.items()}
    except Exception:
        return bundle


def bi(en: str, ar: str, tag: str = "span") -> str:
    """One bilingual element — both present, CSS shows one."""
    return f'<{tag} class="en">{en}</{tag}><{tag} class="ar">{ar}</{tag}>'


def build(run: Path, d: dict) -> str:
    order = ["DO NOT SHIP", "SHIP WITH FIXES", "SHIP", "NO REVIEW"]
    vs = [r["verdict"] for r in d["reviews"]] or ["NO REVIEW"]
    overall = sorted(vs, key=lambda v: order.index(v) if v in order else 9)[0]
    v_en, v_ar, v_cls = VERDICTS[overall]

    if overall == "SHIP":
        cmd = f'git -C {d["repo"]} merge {d["branch"]}'
        why_en, why_ar = T["merge"]
    else:
        cmd = f'less {run}/change.diff'
        why_en, why_ar = T["inspect"]

    cards = []
    for r in d["reviews"]:
        e, a, cls = VERDICTS[r["verdict"]]
        if r["points"]:
            pts = "".join(
                f'<li>{bi(md_code(en), md_code(ar))}</li>'
                for en, ar in zip(r["points"], r["points_ar"])
            )
        else:
            pts = f'<li>{bi(esc(T["noreview"][0]), esc(T["noreview"][1]))}</li>'
        cards.append(
            f'<div class="card"><div class="chead">'
            f'<span class="dot {cls}"></span><h3>{esc(r["name"])}</h3>'
            f'<span class="badge {cls}">{bi(esc(e), esc(a))}</span></div>'
            f'<ul>{pts}</ul></div>'
        )

    author_pts = "".join(
        f'<li>{bi(md_code(en), md_code(ar))}</li>'
        for en, ar in zip(d["author_points"], d["author_points_ar"])
    ) or f'<li>—</li>'

    files = "".join(f"<li><code>{esc(f)}</code></li>" for f in d["files"][:14]) \
        or f'<li>{bi(esc(T["nofiles"][0]), esc(T["nofiles"][1]))}</li>'

    return f"""<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="light" data-lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{esc(d['branch'])} — {esc(v_en)}</title>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&family=Noto+Sans+Arabic:wght@400;500;600&family=Noto+Kufi+Arabic:wght@400;700&display=swap" rel="stylesheet">
<style>{CSS}</style>
</head>
<body>

<div class="bar">
  <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
  <button type="button" data-set-lang="ar" aria-pressed="false" lang="ar">ع</button>
  <span class="sep"></span>
  <button type="button" data-set-theme="light" aria-pressed="true">LIGHT</button>
  <button type="button" data-set-theme="dark" aria-pressed="false">DARK</button>
</div>

<div class="wrap">
  <p class="eyebrow">{bi(esc(T['eyebrow'][0]), esc(T['eyebrow'][1]))} · {esc(d['repo_name'])}</p>
  <h1>{esc(d['branch'])}</h1>
  <p class="sub">{bi(esc(d['task']), esc(d['task_ar']))}</p>

  <div class="action">
    <p class="k">{bi(esc(T['next'][0]), esc(T['next'][1]))}</p>
    <code>{esc(cmd)}</code>
    <p class="why">{bi(esc(why_en), esc(why_ar))}</p>
  </div>

  <div class="stats">
    <div class="stat">
      <p class="k">{bi(esc(T['verdict'][0]), esc(T['verdict'][1]))}</p>
      <p class="v {v_cls}">{bi(esc(v_en), esc(v_ar))}</p>
    </div>
    <div class="stat">
      <p class="k">{bi(esc(T['author'][0]), esc(T['author'][1]))}</p>
      <p class="v">{esc(d['author'])}</p>
    </div>
    <div class="stat">
      <p class="k">{bi(esc(T['changed'][0]), esc(T['changed'][1]))}</p>
      <p class="v">{d['changed']} {bi(esc(T['lines'][0]), esc(T['lines'][1]))}</p>
    </div>
  </div>

  <h2>{bi(esc(T['what'][0]), esc(T['what'][1]))}</h2>
  <div class="card"><ul>{author_pts}</ul></div>

  <h2>{bi(esc(T['reviews'][0]), esc(T['reviews'][1]))}</h2>
  {''.join(cards)}

  <h2>{bi(esc(T['files'][0]), esc(T['files'][1]))}</h2>
  <div class="card"><ul>{files}</ul></div>

  <div class="foot">
    <span><code>{esc(str(run))}</code></span>
    <span>herdr-pipeline</span>
  </div>
</div>

<script>{JS}</script>
</body>
</html>"""


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("run")
    ap.add_argument("--task", default="")
    ap.add_argument("--serve", action="store_true")
    ap.add_argument("--no-translate", action="store_true",
                    help="skip the Arabic translation pass (faster, EN body in both)")
    a = ap.parse_args()

    run = Path(a.run).expanduser().resolve()
    if not run.is_dir():
        print(f"not a directory: {run}", file=sys.stderr)
        return 1

    changed, files = diff_stats(read(run / "change.diff"))

    af = next(iter(sorted(run.glob("author-*.md"))), None)
    author = af.stem.replace("author-", "") if af else "?"
    author_points = tail_summary(read(af)) if af else []

    reviews = []
    for rf in sorted(run.glob("review-*.md")) + sorted(run.glob("review-*.FAILED.md")):
        name = rf.stem.replace("review-", "").replace(".FAILED", "")
        txt = read(rf)
        failed = rf.name.endswith(".FAILED.md") or not txt.strip()
        reviews.append(dict(name=name,
                            verdict="NO REVIEW" if failed else verdict_of(txt),
                            points=[] if failed else tail_summary(txt, 5)))

    task = a.task or f"see {run}/"
    bundle = {"task": [task], "author": author_points}
    for i, r in enumerate(reviews):
        bundle[f"r{i}"] = r["points"]

    tr = bundle if a.no_translate else translate_ar(bundle)

    d = dict(
        repo=str(Path.home() / "projects" / run.parent.name),
        repo_name=run.parent.name,
        branch=run.name.replace("-", "/", 1),
        task=task,
        task_ar=(tr.get("task") or [task])[0],
        author=author,
        author_points=author_points,
        author_points_ar=tr.get("author", author_points),
        changed=changed, files=files,
        reviews=[dict(r, points_ar=tr.get(f"r{i}", r["points"]))
                 for i, r in enumerate(reviews)],
    )

    out = run / "report.html"
    out.write_text(build(run, d), encoding="utf-8")
    print(f"wrote: {out}")

    if a.serve:
        ve = Path.home() / ".hermes/skills/openclaw-imports/visual-explainer/scripts/serve.py"
        if ve.exists():
            try:
                r = subprocess.run([sys.executable, str(ve), "serve", str(out)],
                                   capture_output=True, text=True, timeout=60)
                line = (r.stdout or r.stderr).strip().splitlines()
                if line:
                    print(line[-1])
            except Exception as e:
                print(f"serve failed: {e}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
