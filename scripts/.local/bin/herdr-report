#!/usr/bin/env python3
"""herdr-report — turn a finished pipeline run into ONE self-contained report.

    herdr-report <run-dir> [--task "..."] [--serve]

Produces a single file:

    report.html

It carries English and Arabic, light and dark, in one document. Two toggles in
the corner switch language and theme; the choice is remembered in localStorage.
Both languages live in the DOM and are switched with CSS, so there is no second
file to keep in sync and no chance of one drifting from the other.

Without JavaScript the page still renders: English, light, fully readable.

Writing shape follows the i-have-adhd skill - the next action leads, the verdict
is visible without scrolling, multi-step work is numbered. Styling follows
diagram-design - editorial tokens, hairline borders, no shadows, coral on
exactly one element.

The Arabic side is a real RTL document (dir flips to rtl, layout mirrors), not
English glyphs poured into a left-to-right page. Code, paths and commands stay
LTR inside Arabic sentences because a reversed shell command is wrong, not
localized.
"""

from __future__ import annotations

import argparse
import html
import json
import re
import subprocess
import sys
from pathlib import Path

VERDICTS = {
    "SHIP": ("SHIP", "جاهز للدمج", "ok"),
    "SHIP WITH FIXES": ("SHIP WITH FIXES", "جاهز بعد إصلاحات", "warn"),
    "DO NOT SHIP": ("DO NOT SHIP", "لا تدمجه", "bad"),
    "NO REVIEW": ("NO REVIEW", "بدون مراجعة", "soft"),
}

T = {
    "eyebrow": ("Pipeline run", "تشغيل خط المعالجة"),
    "next": ("Do this next", "الخطوة التالية"),
    "what": ("What the author did", "ما الذي نفّذه المنفّذ"),
    "reviews": ("What the reviewers said", "ماذا قال المراجعون"),
    "files": ("Files touched", "الملفات المعدّلة"),
    "verdict": ("Verdict", "الحكم"),
    "author": ("Author", "المنفّذ"),
    "changed": ("Changed", "التغييرات"),
    "lines": ("lines", "سطر"),
    "merge": ("Both reviewers are happy. Merge it.",
              "المراجعان راضيان. يمكنك الدمج."),
    "inspect": ("At least one reviewer flagged something. Read the diff first.",
                "أبدى أحد المراجعين ملاحظات. اقرأ الفرق أولاً."),
    "noreview": ("This reviewer produced no usable review — treat that as unknown, not as approval.",
                 "لم ينتج هذا المراجع مراجعة صالحة — اعتبر ذلك مجهولاً وليس موافقة."),
    "nofiles": ("No files recorded", "لا توجد ملفات مسجلة"),
}

CSS = r"""
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --paper:#f5f5f5; --paper2:#ffffff; --ink:#2d3142; --muted:#4f5d75;
  --soft:#7a8399; --rule:rgba(45,49,66,0.12); --accent:#eb6c36;
  --tint:rgba(235,108,54,0.08); --ok:#7c8f6f; --warn:#b8915a; --bad:#b85450;
  --sans:'Geist',system-ui,sans-serif;
  --serif:'Instrument Serif',Georgia,serif;
  --mono:'Geist Mono',ui-monospace,Menlo,monospace;
}
[data-theme="dark"]{
  --paper:#2d3142; --paper2:#393e53; --ink:#f5f5f5; --muted:#bfc0c0;
  --soft:#8e98ac; --rule:rgba(245,245,245,0.14); --accent:#f08a59;
  --tint:rgba(240,138,89,0.12); --ok:#9caf8f; --warn:#d3ad7a; --bad:#d97a78;
}
[data-lang="ar"]{
  --sans:'Noto Sans Arabic','Geist',system-ui,sans-serif;
  --serif:'Noto Kufi Arabic','Instrument Serif',Georgia,serif;
}
