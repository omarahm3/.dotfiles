/* language switching: both live in the DOM, CSS picks one */
[data-lang="en"] .ar{display:none}
[data-lang="ar"] .en{display:none}
[data-lang="ar"] li{padding-left:0;padding-right:1rem}
[data-lang="ar"] li::before{left:auto;right:0}
[data-lang="ar"] ol{padding-left:0;padding-right:1.2rem}

/* toolbar */
.bar{max-width:820px;margin:0 auto 1.5rem;display:flex;gap:.4rem;
  justify-content:flex-end;flex-wrap:wrap}
