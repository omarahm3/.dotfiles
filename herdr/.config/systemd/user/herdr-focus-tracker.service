[Unit]
Description=Track herdr focus history for last-space / last-window toggles
Documentation=man:herdr(1)

[Service]
Type=simple
ExecStart=%h/.local/bin/herdr-focus-tracker
# The tracker reconnects on its own while herdr is down; restart only covers
# an unexpected crash.
Restart=always
RestartSec=5
# Log noise is limited to one reconnect line per herdr restart.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
