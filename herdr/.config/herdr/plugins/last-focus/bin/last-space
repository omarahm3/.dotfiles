#!/usr/bin/env bash
# Focus the previously focused space (tmux last-window, at session level).

set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/lib.sh"

previous=$(last_focus_read "space.previous")
[[ -n $previous ]] || exit 0

# A stale id just means the space is gone; failing to focus it is a no-op.
herdr workspace focus "$previous" >/dev/null 2>&1 || exit 0
