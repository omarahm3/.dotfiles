#!/usr/bin/env bash
# Focus the previously focused tab inside the active space (tmux: bind-key a
# last-window). herdr hands the plugin the active ids, so this needs no lookup.

set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/lib.sh"

workspace=${HERDR_WORKSPACE_ID:-$(last_focus_focused_workspace)}
[[ -n $workspace ]] || exit 0

previous=$(last_focus_read "tab.${workspace}.previous")
[[ -n $previous ]] || exit 0

# A stale id just means the tab is gone; failing to focus it is a no-op.
herdr tab focus "$previous" >/dev/null 2>&1 || exit 0
