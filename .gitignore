
__pycache__/
*.pyc

# herdr writes runtime state into its config dir, which is stowed as a symlink.
# plugins.json is a registry rebuilt by `sync herdr`, so it stays out of git.
herdr/.config/herdr/*.log
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/plugins.json
herdr/.config/herdr/session.json
herdr/.config/herdr/session-history.json
